{
  "compilerOptions": {
    "target": "ES2022", 
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "paths": {
      "#src/*": ["./src/*"],
      "#config/*": ["./src/config/*"],
      "#controllers/*": ["./src/controllers/*"],
      "#models/*": ["./src/models/*"],
      "#routes/*": ["./src/routes/*"],
      "#services/*": ["./src/services/*"],
      "#utils/*": ["./src/utils/*"],
      "#lib/*": ["./src/lib/*"],
      "#validations/*": ["./src/validations/*"],
      "#middleware/*": ["./src/middleware/*"],
      "#types/*": ["./src/types/*"]
    }
  },
  "include": ["src/**/*"]
}